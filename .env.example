# Local credentials for the data pipeline — copy to .env and fill in.
# Setup walkthrough: docs/setup-google-sheets-api.md
# .env is gitignored; this template file is the committed reference.

# --- Google Sheets queue (Issue #13) ---
# The long ID from your Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Service account key JSON, pasted as ONE line (no newlines)
GCP_SA_JSON=

# --- LLM extraction (Issue #12) ---
# One of the providers below. Inline comments after values are stripped by the loader.
LLM_PROVIDER=anthropic            # anthropic | deepseek | fireworks | openai | modal (openai/modal need base URL)

# anthropic:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# deepseek (OpenAI-compatible; base defaults to api.deepseek.com):
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# fireworks / fireworks.ai (LLM inference host; base defaults to api.fireworks.ai/inference/v1):
# LLM_API_KEY=
# LLM_MODEL=accounts/fireworks/models/<model-name>

# openai / modal / modal.com — any self-hosted OpenAI-compatible endpoint:
# (a missing "/v1" suffix on LLM_BASE_URL is auto-corrected; LLM_API_KEY may be
#  left empty for unauthenticated endpoints)
# LLM_BASE_URL=https://<workspace>--<app>.<region>.modal.direct/v1
# LLM_API_KEY=
# LLM_MODEL=<your-served-model-name>

# firecrawl (optional article scraper for JS-heavy news pages — a scraper, not an LLM):
# FC_API_KEY=
