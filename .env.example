# Local credentials for the data pipeline — copy to .env and fill in.
# Setup walkthrough: docs/setup-google-sheets-api.md
# .env is gitignored; this template file is the committed reference.

# --- Google Sheets queue (Issue #13) ---
# The long ID from your Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Service account key JSON, pasted as ONE line (no newlines)
GCP_SA_JSON=

# --- LLM extraction (Issue #12) ---
# One of the providers below. See docs/setup-google-sheets-api.md for the Sheets part.
LLM_PROVIDER=anthropic            # anthropic | deepseek | openai (any OpenAI-compatible, incl. Modal)

# anthropic:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# deepseek:                       (OpenAI-compatible; defaults to api.deepseek.com)
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# openai / Modal-hosted / Groq / Together / OpenRouter:
# LLM_API_KEY=
# LLM_BASE_URL=https://your-endpoint.example/v1
# LLM_MODEL=your-model-name

# Firecrawl (optional article scraper for JS-heavy news pages):
# FC_API_KEY=
